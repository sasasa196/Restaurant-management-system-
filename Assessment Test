<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Laundry Mate CPU Assessment</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background-color: #f4f4f4;
        }

        .role-selection-container {
            background-color: #fff;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.15);
            text-align: center;
        }

        .role-button {
            padding: 12px 24px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 1.1em;
            margin: 10px;
            transition: background-color 0.2s ease-in-out;
        }

        .role-button:hover {
            background-color: #0056b3;
        }

        .container {
            width: 80%;
            max-width: 700px;
            /* Increased max-width */
            display: none;
            /* Initially hide the test */
        }

        .question-card,
        .result-card {
            background-color: #fff;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.15);
            margin-bottom: 20px;
        }

        .question-card h2 {
            margin-top: 0;
            color: #333;
            border-bottom: 2px solid #eaeaea;
            padding-bottom: 10px;
        }

        .question-text {
            font-size: 1.1em;
            color: #444;
            margin-bottom: 15px;
        }

        .options-container {
            display: grid;
            grid-template-columns: 1fr;
            gap: 12px;
            margin-bottom: 20px;
        }

        .option {
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
            cursor: pointer;
            background-color: #f9f9f9;
            transition: background-color 0.2s ease-in-out, border-color 0.2s ease-in-out;
        }

        .option:hover {
            background-color: #eaeaea;
            border-color: #aaa;
        }

        .correct {
            background-color: #d4edda;
            border-color: #c3e6cb;
            color: #155724;
        }

        .incorrect {
            background-color: #f8d7da;
            border-color: #f5c6cb;
            color: #721c24;
        }

        .button-container {
            text-align: center;
            margin-bottom: 20px;
        }

        #next-btn {
            padding: 12px 24px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 1em;
            transition: background-color 0.2s ease-in-out;
        }

        #next-btn:hover {
            background-color: #0056b3;
        }

        #feedback-container {
            text-align: center;
            font-weight: bold;
            margin-bottom: 15px;
            font-size: 1.1em;
        }

        #timer-container {
            text-align: right;
            font-size: 0.95em;
            color: #777;
        }

        .result-card {
            display: none;
            /* Initially hide the results */
            text-align: center;
        }

        .result-card h2 {
            color: #333;
            margin-bottom: 20px;
        }

        .result-card p {
            font-size: 1.2em;
            color: #444;
        }

        #final-score {
            font-weight: bold;
            color: #007bff;
        }
    </style>
</head>

